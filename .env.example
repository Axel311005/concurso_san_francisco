# PostgreSQL (Neon, Supabase o Vercel Postgres)
# Neon: URL con "-pooler" para la app + pgbouncer=true (Prisma)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connect_timeout=30"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DB?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require&pgbouncer=true&connect_timeout=30&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# URL pública de la app (para QR y enlaces en producción)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
